# Reference copy of the environment variables (see README, section 4).
# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Gateway (published port) ---
# Host port used by compose and as the default listen port for `make run`.
BRIDGE_PORT=4000

# SQLite persistence. Defaults to data/bridge.db; compose mounts it in /app/data.
# BRIDGE_DB=/app/data/bridge.db

# --- Bifrost AI ---
BIFROST_MASTER_KEY=

# --- Local ONNX engines ---
# "1" (default) downloads missing ONNX artifacts on first start; "0" disables
# downloads for an offline or pre-provisioned image.
ONNX_AUTO_DOWNLOAD=1
# Override the ONNX Runtime shared library when it is not in the default path.
# ONNX_RUNTIME_LIB=/usr/local/lib/libonnxruntime.so

# --- Ollama (container network -> host) ---
# OLLAMA_HOST=http://host.docker.internal:11434
